<Window x:Class="Pasziansz.WinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Győzelem"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="18">
        <Border CornerRadius="18" Background="{StaticResource Brush.WindowBackground}"
                BorderBrush="#803FAE7C" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270"
                                  Color="Black" Opacity="0.6" />
            </Border.Effect>
            <Grid>
                <!-- Dekoratív háttér -->
                <Border CornerRadius="18" Opacity="0.5">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="0.9">
                            <GradientStop Color="#332FAE72" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel Margin="28,26,28,22">
                    <!-- Négylevelű lóhere / ász ikon -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="♠" FontSize="34" Foreground="{StaticResource Brush.Cream}" Margin="4,0" />
                        <TextBlock Text="♥" FontSize="34" Foreground="#FFE08C7A" Margin="4,0" />
                        <TextBlock Text="♦" FontSize="34" Foreground="#FFE08C7A" Margin="4,0" />
                        <TextBlock Text="♣" FontSize="34" Foreground="{StaticResource Brush.Cream}" Margin="4,0" />
                    </StackPanel>

                    <TextBlock Text="MEGNYERTED!" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Gold}" HorizontalAlignment="Center" />

                    <TextBlock x:Name="RecordText" Text="Új rekord született!" FontSize="12.5"
                               Foreground="{StaticResource Brush.EmeraldBright}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed" />

                    <Border CornerRadius="12" Background="#1AFFFFFF" BorderBrush="#33A8E0BE"
                            BorderThickness="1" Padding="18,14" Margin="0,18,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Pontszám" Style="{StaticResource Text.Body}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ScoreValue" Text="0"
                                       Style="{StaticResource Text.StatusValue}" FontSize="17"
                                       Foreground="{StaticResource Brush.Gold}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Text="Eltelt idő" Style="{StaticResource Text.Body}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TimeValue" Text="00:00"
                                       Style="{StaticResource Text.StatusValue}" FontSize="17" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2" Text="Lépések" Style="{StaticResource Text.Body}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MovesValue" Text="0"
                                       Style="{StaticResource Text.StatusValue}" FontSize="17" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3" Text="Változat" Style="{StaticResource Text.Body}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="VariantValue" Text="1 lapos"
                                       Style="{StaticResource Text.StatusValue}" FontSize="17" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource Button.Primary}" Click="PlayAgain_Click"
                                Margin="0,0,10,0" Padding="18,9" MinWidth="120">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↻" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Új játék" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Base}" Click="Close_Click" Padding="18,9" MinWidth="100">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Bezárás" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
