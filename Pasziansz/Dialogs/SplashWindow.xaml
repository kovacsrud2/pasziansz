<Window x:Class="Pasziansz.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gészi pasziánsz"
        Width="948" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Icon="pack://application:,,,/Assets/App.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!--
        BETÖLTŐ KÉPERNYŐ
        ================
        Indításkor rövid ideig látszik: a program ikonképe (kepernyo_2.png) tölti
        ki az ablakot, arányosan méretezve. A kép a binárisba van beépítve
        (Assets\Splash), ezért külön fájl nem kell mellé.

        A kép már tartalmazza a feliratot, ezért itt nincs semmilyen szöveg.

        A kép Border-háttérként (ImageBrush) jelenik meg, mert így a lekerekített
        sarkok vágása is helyesen működik (a Border a gyermek-elemeket nem vágná).
    -->
    <Grid Margin="12">
        <Border CornerRadius="14" BorderBrush="#553FAE7C" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270"
                                  Color="Black" Opacity="0.65" />
            </Border.Effect>

            <Border.Background>
                <ImageBrush ImageSource="pack://application:,,,/Assets/Splash/kepernyo_2.png"
                            Stretch="UniformToFill"
                            RenderOptions.BitmapScalingMode="HighQuality" />
            </Border.Background>
        </Border>
    </Grid>
</Window>
