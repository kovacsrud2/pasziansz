<Window x:Class="Pasziansz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Pasziansz.Controls"
        mc:Ignorable="d"
        Title="Zöld Pasziánsz"
        Width="1260" Height="840"
        MinWidth="980" MinHeight="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="Assets/App.ico">

    <!--
        Keret nélküli, lekerekített ablak. A külső Grid adja az árnyékot,
        a belső Border a lekerekített felületet. A címkesáv saját (húzható),
        a sarkokban saját átméretező-fogantyúk vannak.
    -->
    <Grid x:Name="WindowRoot" Margin="14">
        <!-- Vetett árnyék -->
        <Border CornerRadius="16" Background="#FF061A12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270"
                                  Color="Black" Opacity="0.55" />
            </Border.Effect>
        </Border>

        <!-- A tényleges ablakfelület -->
        <Border x:Name="WindowChrome"
                CornerRadius="16"
                Background="{StaticResource Brush.WindowBackground}"
                BorderBrush="#4D3E8F6B"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- címkesáv -->
                    <RowDefinition Height="*" />      <!-- játéktér -->
                    <RowDefinition Height="Auto" />   <!-- állapotsáv -->
                </Grid.RowDefinitions>

                <!-- ==================== CÍMKESÁV ==================== -->
                <Border Grid.Row="0" Background="{StaticResource Brush.TitleBar}"
                        BorderBrush="#26A8E0BE" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        MouseMove="TitleBar_MouseMove">
                    <Grid Margin="18,10,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Logó + cím -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="8"
                                    Background="{StaticResource Brush.Emerald}"
                                    BorderBrush="#663FAE7C" BorderThickness="1">
                                <TextBlock Text="♠" FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Cream}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ZÖLD PASZIÁNSZ" Style="{StaticResource Text.Title}"
                                           FontSize="13.5" />
                                <TextBlock x:Name="SubtitleText" Text="Klondike · 1 lapos húzás"
                                           Style="{StaticResource Text.Caption}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Középső: játékinfók -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="IDŐ" Style="{StaticResource Text.StatusLabel}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TimeText" Text="00:00" Style="{StaticResource Text.StatusValue}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="LÉPÉSEK" Style="{StaticResource Text.StatusLabel}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MovesText" Text="0" Style="{StaticResource Text.StatusValue}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="PONTSZÁM" Style="{StaticResource Text.StatusLabel}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="ScoreText" Text="0" Style="{StaticResource Text.StatusValue}"
                                           Foreground="{StaticResource Brush.Gold}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="PAKLI" Style="{StaticResource Text.StatusLabel}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="StockText" Text="24" Style="{StaticResource Text.StatusValue}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Ablakgombok -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Window}" Click="RulesButton_Click"
                                    ToolTip="Játékszabály (F1)" Margin="0,0,4,0">
                                <TextBlock Text="?" FontSize="14" FontWeight="Bold" />
                            </Button>
                            <Button x:Name="MinimizeButton" Style="{StaticResource Button.Window}"
                                    Click="MinimizeButton_Click" ToolTip="Kis méret">
                                <Path Data="M 2,7 L 14,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" />
                            </Button>
                            <Button x:Name="MaximizeButton" Style="{StaticResource Button.Window}"
                                    Click="MaximizeButton_Click" ToolTip="Teljes méret">
                                <Path x:Name="MaximizeIcon"
                                      Data="M 2,2 L 14,2 L 14,14 L 2,14 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" Fill="Transparent" />
                            </Button>
                            <Button Style="{StaticResource Button.WindowClose}"
                                    Click="CloseButton_Click" ToolTip="Bezárás">
                                <Path Data="M 3,3 L 13,13 M 13,3 L 3,13"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== JÁTÉKTÉR ==================== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Kártyaasztal -->
                    <Grid Grid.Column="0" Margin="0">
                        <!-- Filc textúra + vignetta -->
                        <Border CornerRadius="0" ClipToBounds="True">
                            <Grid>
                                <Image Source="Assets/Textures/felt.png" Stretch="UniformToFill"
                                       Opacity="0.55" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border>
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45"
                                                             RadiusX="0.75" RadiusY="0.8">
                                            <GradientStop Color="#000B3022" Offset="0" />
                                            <GradientStop Color="#B30A2A1D" Offset="0.72" />
                                            <GradientStop Color="#E6051710" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <!-- Belső keret-vonal, mint egy kártyaasztal szegélye -->
                                <Border Margin="10" CornerRadius="10" BorderBrush="#22A8E0BE"
                                        BorderThickness="1" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <!-- A kártyaasztal vezérlő -->
                        <controls:CardTableView x:Name="Table" Margin="8,4,8,4" />

                        <!-- Eszköztár a tábla alján -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="0,0,0,14" Background="#E6082318"
                                BorderBrush="#33A8E0BE" BorderThickness="1" CornerRadius="14"
                                Padding="10,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                                  Color="Black" Opacity="0.45" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="NewGameButton" Style="{StaticResource Button.Primary}"
                                        Click="NewGameButton_Click" ToolTip="Új osztás (F2)"
                                        Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↻" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Új játék" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RestartButton" Style="{StaticResource Button.Base}"
                                        Click="RestartButton_Click" ToolTip="Ugyanennek az osztásnak az újrajátszása (F5)"
                                        Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⟲" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Újraosztás" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="UndoButton" Style="{StaticResource Button.Base}"
                                        Click="UndoButton_Click" ToolTip="Utolsó lépés visszavonása (Ctrl+Z)"
                                        Margin="0,0,6,0" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↶" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Visszavonás" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="HintButton" Style="{StaticResource Button.Base}"
                                        Click="HintButton_Click" ToolTip="Tipp kérése (H)"
                                        Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✧" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Gold}" />
                                        <TextBlock Text="Tipp" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AutoPlayButton" Style="{StaticResource Button.Base}"
                                        Click="AutoPlayButton_Click" ToolTip="Minden felvehető lap felpakolása (A)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⇪" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Auto pakolás" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Lebegő üzenet -->
                        <controls:ToastHost x:Name="Toast" VerticalAlignment="Bottom" Margin="0,0,0,72" />
                    </Grid>

                    <!-- Oldalsáv (billentyűk, infó) -->
                    <Border Grid.Column="1" Width="292" Margin="0"
                            Background="#CC08241A" BorderBrush="#26A8E0BE" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource ScrollViewer.Green}" Padding="0,0,4,0">
                            <StackPanel Margin="18,16,18,18">

                                <!-- Húzás mód -->
                                <TextBlock Text="HÚZÁSI MÓD" Style="{StaticResource Text.SectionHeader}" />
                                <Border Style="{StaticResource Panel.Card}" Padding="6" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="DrawOneToggle" Grid.Column="0"
                                                      Style="{StaticResource Segment.Toggle}"
                                                      Content="1 lapos" Click="DrawModeToggle_Click"
                                                      ToolTip="Könnyebb változat: egyszerre egy lapot húzol." />
                                        <ToggleButton x:Name="DrawThreeToggle" Grid.Column="1"
                                                      Style="{StaticResource Segment.Toggle}"
                                                      Content="3 lapos" Click="DrawModeToggle_Click"
                                                      ToolTip="Nehezebb változat: egyszerre három lapot húzol." />
                                    </Grid>
                                </Border>

                                <!-- Kártyahátlap -->
                                <TextBlock Text="KÁRTYAHÁTLAP" Style="{StaticResource Text.SectionHeader}" />
                                <Border Style="{StaticResource Panel.Card}" Padding="12,10" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <controls:CardBackPreview x:Name="BackGreen" BackStyle="Green" Margin="0,0,10,0"
                                                                      Cursor="Hand" MouseLeftButtonDown="BackGreen_Click"
                                                                      ToolTip="Fenyőzöld hátlap" />
                                            <controls:CardBackPreview x:Name="BackBlue" BackStyle="Blue" Margin="0,0,10,0"
                                                                      Cursor="Hand" MouseLeftButtonDown="BackBlue_Click"
                                                                      ToolTip="Tengerkék hátlap" />
                                            <controls:CardBackPreview x:Name="BackRed" BackStyle="Red"
                                                                      Cursor="Hand" MouseLeftButtonDown="BackRed_Click"
                                                                      ToolTip="Bordóvörös hátlap" />
                                        </StackPanel>
                                        <TextBlock x:Name="BackStyleText" Text="Fenyőzöld" Style="{StaticResource Text.Caption}"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Billentyűparancsok -->
                                <TextBlock Text="BILLENTYŰPARANCSOK" Style="{StaticResource Text.SectionHeader}" />
                                <Border Style="{StaticResource Panel.Card}" Padding="12,10" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyCap}"><TextBlock Text="Szóköz" Style="{StaticResource KeyCap.Text}" /></Border>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Húzás / felpakolás" Style="{StaticResource Text.Body}" />

                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyCap}"><TextBlock Text="1 – 7" Style="{StaticResource KeyCap.Text}" /></Border>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Kiválasztott lap áthelyezése az oszlopra" Style="{StaticResource Text.Body}" />

                                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyCap}"><TextBlock Text="H" Style="{StaticResource KeyCap.Text}" /></Border>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Tipp kérése" Style="{StaticResource Text.Body}" />

                                        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyCap}"><TextBlock Text="A" Style="{StaticResource KeyCap.Text}" /></Border>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Auto pakolás" Style="{StaticResource Text.Body}" />

                                        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl+Z" Style="{StaticResource KeyCap.Text}" /></Border>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Visszavonás" Style="{StaticResource Text.Body}" />

                                        <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource KeyCap}"><TextBlock Text="F2" Style="{StaticResource KeyCap.Text}" /></Border>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Új játék" Style="{StaticResource Text.Body}" />

                                        <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource KeyCap}"><TextBlock Text="F1" Style="{StaticResource KeyCap.Text}" /></Border>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Játékszabály" Style="{StaticResource Text.Body}" />

                                        <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource KeyCap}"><TextBlock Text="F5" Style="{StaticResource KeyCap.Text}" /></Border>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="Ugyanazon osztás újrajátszása" Style="{StaticResource Text.Body}" />
                                    </Grid>
                                </Border>

                                <!-- Statisztika -->
                                <TextBlock Text="STATISZTIKA" Style="{StaticResource Text.SectionHeader}" />
                                <Border Style="{StaticResource Panel.Card}" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Játszmák" Style="{StaticResource Text.Body}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatGamesText"
                                                   Style="{StaticResource Text.StatusValue}" FontSize="12.5" Text="0" />

                                        <TextBlock Grid.Row="1" Text="Megnyerve" Style="{StaticResource Text.Body}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatWinsText"
                                                   Style="{StaticResource Text.StatusValue}" FontSize="12.5" Text="0" />

                                        <TextBlock Grid.Row="2" Text="Nyerési arány" Style="{StaticResource Text.Body}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StatWinRateText"
                                                   Style="{StaticResource Text.StatusValue}" FontSize="12.5" Text="0%" />

                                        <TextBlock Grid.Row="3" Text="Legjobb idő" Style="{StaticResource Text.Body}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="StatBestTimeText"
                                                   Style="{StaticResource Text.StatusValue}" FontSize="12.5" Text="–" />

                                        <TextBlock Grid.Row="4" Text="Legjobb pont" Style="{StaticResource Text.Body}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="StatBestScoreText"
                                                   Style="{StaticResource Text.StatusValue}" FontSize="12.5" Text="–" />
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ==================== ÁLLAPOTSÁV ==================== -->
                <Border Grid.Row="2" Background="#FF07211A" BorderBrush="#26A8E0BE"
                        BorderThickness="0,1,0,0" Padding="18,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="StatusText" Text="Új osztás – sok szerencsét!"
                                   Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="HintStatusText" Text=""
                                   Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Gold}" />
                    </Grid>
                </Border>

                <!-- Átméretező-fogantyúk a sarkokban -->
                <Thumb x:Name="ResizeNW" Width="14" Height="14" HorizontalAlignment="Left"
                       VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="ResizeNW_DragDelta" />
                <Thumb x:Name="ResizeNE" Width="14" Height="14" HorizontalAlignment="Right"
                       VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="ResizeNE_DragDelta" />
                <Thumb x:Name="ResizeSW" Width="14" Height="14" HorizontalAlignment="Left"
                       VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="ResizeSW_DragDelta" />
                <Thumb x:Name="ResizeSE" Width="14" Height="14" HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeSE_DragDelta" />
            </Grid>
        </Border>
    </Grid>
</Window>
