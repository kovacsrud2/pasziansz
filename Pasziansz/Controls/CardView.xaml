<UserControl x:Class="Pasziansz.Controls.CardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="108" d:DesignHeight="157"
             Width="108" Height="157"
             HorizontalAlignment="Left" VerticalAlignment="Top"
             SnapsToDevicePixels="True"
             IsTabStop="False" Focusable="False"
             Background="Transparent">
    <Grid x:Name="Root">
        <!-- Kártyahátlap: lefordított állapot -->
        <Border x:Name="BackLayer" CornerRadius="8" Visibility="Collapsed"
                BorderBrush="#66C8EBD2" BorderThickness="1" Background="#FF0B3A28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270"
                                  Color="Black" Opacity="0.35" />
            </Border.Effect>
        </Border>

        <!-- Kártyalap: felfordított állapot -->
        <Border x:Name="FaceLayer" CornerRadius="8" Background="#FFF8F5EA"
                BorderBrush="#33000000" BorderThickness="0.6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270"
                                  Color="Black" Opacity="0.35" />
            </Border.Effect>
            <!-- A kártyaképek eleve lekerekített, átlátszó sarkúak. -->
            <Image x:Name="FaceImage" Stretch="Fill" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <!-- Tartalék: ha a kép nem található -->
        <Border x:Name="FallbackLayer" CornerRadius="8" Background="#FFF6F2E6" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="FallbackRank" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="#FF1B1B1B" />
                <TextBlock x:Name="FallbackSuit" FontSize="24"
                           HorizontalAlignment="Center" Foreground="#FF1B1B1B" />
            </StackPanel>
        </Border>

        <!-- Kijelölés / tipp kiemelése -->
        <Border x:Name="SelectionRing" CornerRadius="9" Background="Transparent"
                BorderBrush="#FFD8BC78" BorderThickness="2.5"
                Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</UserControl>
